.DS_Store
/.build
/.swiftpm
# The benchmarks package builds on its own; scripts/benchmark.sh gives it the package's pins.
/Benchmarks/.build
/Benchmarks/.swiftpm
/Benchmarks/Package.resolved
# So does the Swift 5 language mode package, with the package's pins copied in by CI.
/Swift5Mode/.build
/Swift5Mode/.swiftpm
/Swift5Mode/Package.resolved
# And the Apple platforms package, built by the Apple checks with the same pins.
/ApplePlatforms/.build
/ApplePlatforms/.swiftpm
/ApplePlatforms/Package.resolved
/Packages
xcuserdata/
DerivedData/
/mutants.tsv
__pycache__/

# SwiftLint, installed by scripts/lint.sh.
/.tools

# What Tuist generates from ApplePlatforms/Package.swift (.github/workflows/apple.yml).
/ApplePlatforms/*.xcodeproj
/ApplePlatforms/*.xcworkspace
/ApplePlatforms/Derived
